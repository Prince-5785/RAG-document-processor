# Groq API Keys (comma-separated for automatic key rotation and rate limit resilience)
GROQ_API_KEYS="gsk_your_groq_api_key_1,gsk_your_groq_api_key_2"

# InsureQuery API Authentication Key (Optional: leave empty in development for permissive mode)
INSUREQUERY_API_KEY=""

# Redis Cache URL (default: redis://localhost:6379/0; fallback to in-memory if unreachable)
REDIS_URL="redis://localhost:6379/0"

# Server Port Configuration
PORT=8000
HOST="0.0.0.0"

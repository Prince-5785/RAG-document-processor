# Groq API Keys (comma-separated for key rotation and rate limit resilience)
GROQ_API_KEYS="gsk_your_groq_api_key_1,gsk_your_groq_api_key_2"

# InsureQuery API Authentication Key (REQUIRED in production, generate with: openssl rand -hex 32)
INSUREQUERY_API_KEY="your_secure_random_api_key_here"

# Allowed CORS Origins (comma-separated, default: https://prince-gupta.me)
ALLOWED_ORIGINS="https://prince-gupta.me"

# Redis Cache URL (inside Docker Compose: redis://redis:6379/0; locally: redis://localhost:6379/0)
REDIS_URL="redis://redis:6379/0"

# Application Environment
APP_ENV="production"
